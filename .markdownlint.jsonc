{
  // プロジェクト共通の markdownlint 設定
  // VSCode の markdownlint 拡張・markdownlint-cli2 の両方が参照します。
  "default": true,

  // MD013(line-length): 日本語ドキュメントおよびコード例では行長制限を設けない
  // （長い解説文やコードコメントを機械的に折り返すのは可読性を損なうため）
  "MD013": false,

  // MD024(no-duplicate-heading): 「### 基本」など同名の見出しは、
  // 異なる親セクション配下であれば許可する（兄弟見出し間のみ重複を禁止）
  "MD024": { "siblings_only": true },

  // MD060(table-column-style): テーブルのパイプ整列を強制しない。
  // 全角（日本語）を含むテーブルは文字数ベースの整列が見た目の幅と一致せず、
  // 整列を満たそうとするとソースが不必要に肥大化するため無効化する。
  "MD060": false
}
